{
  "name": "onchain-invoice",
  "version": "1.0.0",
  "description": "A system for decentralzied on-chain invoicing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "compile": "hardhat compile",
    "test": "hardhat test test/*.ts app/fastswap/test/*.ts app/fastswap/test/system/*.ts LiquidityManager/test/*.ts",
    "test:contracts": "hardhat test",
    "clean": "hardhat clean",
    "sweep-node:build": "tsc -p node/tsconfig.json",
    "sweep-node": "node node-dist/node/index.js",
    "fastswap:build": "tsc -p app/fastswap/tsconfig.json",
    "fastswap:server": "npm run fastswap:build && node app-dist/fastswap/app/fastswap/server/main.js",
    "fastswap:sweep": "npm run fastswap:build && node app-dist/fastswap/app/fastswap/nodes/sweep-main.js",
    "fastswap:relay": "npm run fastswap:build && node app-dist/fastswap/app/fastswap/nodes/relay-node/main.js",
    "fastswap:liqman": "npm run liqman:build && node lm-dist/LiquidityManager/bot/index.js --fastswap-config FastSwapConfig.yaml",
    "fastswap:cli": "npm run fastswap:build && node app-dist/fastswap/app/fastswap/cli/index.js",
    "fastswap:testnet": "npm run fastswap:build && npm run liqman:build && node app-dist/fastswap/app/fastswap/cli/index.js --config FastSwapConfig.testnet.yaml",
    "fastswap:aggregate": "npm run fastswap:build && node app-dist/fastswap/app/fastswap/nodes/aggregate-all/main.js",
    "fastswap:cli:predict": "npm run fastswap:build && node app-dist/fastswap/app/fastswap/cli/index.js --predict",
    "fastswap:cli:verify": "npm run fastswap:build && node app-dist/fastswap/app/fastswap/cli/index.js --verifyAll",
    "fastswap:demo:build": "tsc -p fastSwapDemo/tsconfig.json",
    "fastswap:demo": "node demo-dist/fastSwapDemo/start.js",
    "fastswap:demo:pay": "node demo-dist/fastSwapDemo/pay-invoice.js",
    "fastswap:demo:send": "node demo-dist/fastSwapDemo/pay.js",
    "fastswap:integ": "npm run compile && npm run fastswap:demo:build && node --env-file=fastSwapDemo/.env demo-dist/fastSwapDemo/integration/live-sepolia-tron.js",
    "liqman:build": "tsc -p LiquidityManager/tsconfig.json",
    "liqman": "node lm-dist/LiquidityManager/bot/index.js",
    "docker:build": "docker compose -f docker/compose/api.yml -f docker/compose/nodes.yml build",
    "docker:up:api": "docker compose -f docker/compose/api.yml up -d",
    "docker:up:nodes": "docker compose -f docker/compose/nodes.yml up -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naiemk/onchain-invoice.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/naiemk/onchain-invoice/issues"
  },
  "homepage": "https://github.com/naiemk/onchain-invoice#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.10",
    "@nomicfoundation/hardhat-mocha": "^3.0.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "chai": "^6.2.2",
    "hardhat": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "better-sqlite3": "^12.9.0",
    "ethers": "^6.16.0",
    "tronweb": "^6.3.0",
    "yaml": "^2.9.0"
  }
}
