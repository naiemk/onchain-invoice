{
  "name": "onchain-invoice",
  "version": "1.0.0",
  "description": "A system for decentralzied on-chain invoicing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sweep-node": {
      "types": "./node-dist/node/sweep-node.d.ts",
      "import": "./node-dist/node/sweep-node.js"
    },
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "node-dist",
    "contracts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run sweep-node:build && npm run commerce:build",
    "compile": "hardhat compile",
    "pretest": "tsc",
    "test": "hardhat test test/*.ts",
    "test:contracts": "hardhat test",
    "clean": "hardhat clean",
    "sweep-node:build": "tsc -p node/tsconfig.json",
    "sweep-node": "node node-dist/node/index.js",
    "commerce:build": "tsc -p commerce/tsconfig.json",
    "commerce:server": "node commerce-dist/server/index.js",
    "commerce:sweeper": "node commerce-dist/sweeper/index.js",
    "commerce:bundler": "node commerce-dist/bundler/index.js",
    "commerce:wallet-deployer": "node commerce-dist/wallet-deployer/index.js",
    "ui": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:verify": "bash ui/scripts/verify-ui-steps.sh",
    "docker:certs": "bash deploy/gen-dev-certs.sh",
    "docker:up": "docker compose -f deploy/docker-compose.yml up --build -d",
    "docker:smoke": "bash deploy/smoke-test.sh",
    "docker:down": "docker compose -f deploy/docker-compose.yml down -v",
    "docker:test": "npm run docker:up && sleep 8 && npm run docker:smoke && npm run docker:down",
    "deploy:package": "bash deploy/package.sh",
    "system-test": "bash system-tests/scripts/run.sh",
    "system-test:install": "bash system-tests/scripts/run-install-e2e.sh",
    "system-test:infra-deploy": "bash system-tests/scripts/run-infra-deploy-e2e.sh",
    "test:live-testnet": "LIVE_TESTNET=1 hardhat test test/live/LiveTestnetInvoicePay.ts",
    "solana:build": "cd solana/programs/commerce-invoice && cargo-build-sbf",
    "solana:test": "bash solana/e2e/scripts/run-success.sh",
    "solana:deploy:devnet": "bash solana/scripts/deploy-devnet.sh",
    "solana:smoke:devnet": "bash solana/e2e/scripts/run-devnet-smoke.sh",
    "deploy:console:api": "node --experimental-strip-types --experimental-transform-types deploy/operator/server.ts",
    "deploy:console:ui": "vite --config deploy/operator/ui/vite.config.ts",
    "deploy:console": "node --experimental-strip-types --experimental-transform-types deploy/operator/scripts/dev.mts",
    "wallet:deploy:sepolia": "hardhat run scripts/deploy-wallet.ts --network sepolia",
    "wallet:verify:sepolia": "hardhat run scripts/verify-wallet.ts --network sepolia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naiemk/onchain-invoice.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/naiemk/onchain-invoice/issues"
  },
  "homepage": "https://github.com/naiemk/onchain-invoice#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.10",
    "@nomicfoundation/hardhat-mocha": "^3.0.18",
    "@nomicfoundation/hardhat-verify": "^3.0.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^5.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "chai": "^6.2.2",
    "hardhat": "^3.4.3",
    "playwright-core": "^1.52.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^12.9.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "html5-qrcode": "^2.3.8",
    "js-yaml": "^5.2.3",
    "onchain-invoice": "file:.",
    "qrcode": "^1.5.4",
    "tronweb": "^6.3.0",
    "vibed-infra": "0.8.0",
    "yaml": "^2.9.0"
  }
}
