{
  "name": "onchain-invoice",
  "version": "1.0.0",
  "description": "A system for decentralzied on-chain invoicing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sweep-node": {
      "types": "./node-dist/node/sweep-node.d.ts",
      "import": "./node-dist/node/sweep-node.js"
    },
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "node-dist",
    "contracts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run sweep-node:build",
    "compile": "hardhat compile",
    "test": "hardhat test test/*.ts",
    "test:contracts": "hardhat test",
    "clean": "hardhat clean",
    "sweep-node:build": "tsc -p node/tsconfig.json",
    "sweep-node": "node node-dist/node/index.js",
    "ui": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naiemk/onchain-invoice.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/naiemk/onchain-invoice/issues"
  },
  "homepage": "https://github.com/naiemk/onchain-invoice#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.10",
    "@nomicfoundation/hardhat-mocha": "^3.0.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "hardhat": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "better-sqlite3": "^12.9.0",
    "ethers": "^6.16.0",
    "tronweb": "^6.3.0",
    "yaml": "^2.9.0"
  }
}
