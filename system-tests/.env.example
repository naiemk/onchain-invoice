# Tag of published GHCR images (api, sweeper, ui, nginx).
IMAGE_TAG=main

# Gateway / API
BASE_URL=https://localhost
ADMIN_API_KEY=system-test-admin
SWEEPER_API_KEY=system-test-sweeper
CORS_ORIGINS=*
RATE_LIMIT_CREATE_PER_SECOND=10

# Offline CREATE2 (no live chain). Throwaway addresses for address prediction only.
SWEEPER_ADDRESS=0x1111111111111111111111111111111111111111
FORWARDER_IMPLEMENTATION=0x2222222222222222222222222222222222222222
# Leave empty to use offline prediction; set a public RPC only if you omit FORWARDER_IMPLEMENTATION.
EVM_RPC_URL=

# Hardhat account #0 — throwaway test key (NOT for mainnet / funded use).
# Address: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
SWEEPER_WALLET_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SWEEPER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
