ADMIN_API_KEY=system-test-admin
SWEEPER_API_KEY=system-test-sweeper
CORS_ORIGINS=*
RATE_LIMIT_CREATE_PER_SECOND=10

# Offline CREATE2 (no live chain). Throwaway addresses for address prediction only.
