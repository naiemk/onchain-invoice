{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "../commerce-dist",
    "rootDir": ".",
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "sweeper/**/*.ts", "bundler/**/*.ts", "wallet-deployer/**/*.ts"],
  "exclude": ["node_modules"]
}
