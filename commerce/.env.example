PORT=8080
BASE_URL=http://localhost:8080
DB_PATH=./trustless-commerce.db

# API keys used by the sweep worker and admin dashboard.
SWEEPER_API_KEY=change-me-sweeper
ADMIN_API_KEY=change-me-admin

# EVM activation/sweeping. SWEEPER_ADDRESS enables invoice address derivation.
EVM_RPC_URL=https://sepolia.infura.io/v3/your-key
SWEEPER_ADDRESS=0x0000000000000000000000000000000000000000
SWEEPER_PRIVATE_KEY=

# Optional captcha validation for POST /api/sessions and hosted wallet recovery.
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET=
# Public site key for UI Turnstile widgets (also exposed on GET /api/public/wallet-config).
TURNSTILE_SITE_KEY=

# Hosted wallet recovery email (Resend). When unset, OTP is logged to stderr (dev/test).
# RESEND_API_KEY=
# RESEND_FROM=Trustless Commerce <noreply@example.com>

# Fallback guardian EOA when WALLET_RPC_URL cannot read AdminGuardianRecovery.guardian().
# WALLET_ADMIN_GUARDIAN=0x…
# Optional HMAC secret for guardian session tokens (defaults derived from ADMIN_API_KEY).
# GUARDIAN_SESSION_SECRET=

# Rate limits (per IP). Admin/internal routes are exempt.
# RATE_LIMIT_CREATE_PER_SECOND=1
# RATE_LIMIT_PUBLIC_PER_SECOND=20
# RATE_LIMIT_SWEEPER_PER_SECOND=50
# RATE_LIMIT_WALLET_CLIENT_PER_SECOND=50
# RATE_LIMIT_QUOTE_PER_SECOND=2
# RATE_LIMIT_QUOTE_BURST=20

# Optional card/bank onramp (Onramper).
# - ONRAMPER_ENABLED=1 with no keys → testnet demo UX (local stub page; no real card charge).
# - With API + signing keys → live widget (pk_test → buy.onramper.dev by default).
# ONRAMPER_ENABLED=0
# ONRAMPER_API_KEY=
# ONRAMPER_SIGNING_KEY=   # dashboard HMAC hex (V1) or Ed25519 PEM (V2)
# ONRAMPER_WEBHOOK_SECRET=
# ONRAMPER_WIDGET_ORIGIN=https://buy.onramper.com
# ONRAMPER_FIATS=USD,EUR,GBP,SEK

# Testnet faucet for fiat-only /pay (funds invoiceAddress so sweeper can mark paid).
# Default ON. Set FAUCET_ENABLED=0 on mainnet. Requires FAUCET_SECRET to show the UI control.
# FAUCET_ENABLED=1
# FAUCET_SECRET=change-me-faucet
# FAUCET_PRIVATE_KEY=   # defaults to SWEEPER_PRIVATE_KEY for Sepolia USDC
# FAUCET_TRON_PRIVATE_KEY=  # or TRON_SPONSOR_PRIVATE_KEY for Nile USDT

# Passkey smart wallet (separate from commerce sweeper factory)
# Sepolia deploy: data/wallet-deploy-sepolia.json
WALLET_FACTORY_ADDRESS=0x06964dE197ed29A4DC2D34F68aD4510Afa25f537
WALLET_RECOVERY_ADDRESS=0x72739889bcce2B08a23212bae6C7B9F1C29e7873
WALLET_IMPLEMENTATION_ADDRESS=0xe024cE8ed1878dBdd3ca8E73B1e586c4E46dC85C
WALLET_RECOVERY_TIMELOCK=259200
WALLET_CHAIN_ID=11155111
# WALLET_RPC_URL=   # defaults to EVM_RPC_URL
# Wallet-deployer guardian key for AdminGuardianRecovery (defaults to WALLET_DEPLOYER_PRIVATE_KEY)
# WALLET_GUARDIAN_PRIVATE_KEY=

# Wallet bundler (ERC-4337 userOp relay — separate from commerce sweeper)
WALLET_ENTRYPOINT_ADDRESS=0x433709009B8330FDa32311DF1C2AFA402eD8D009
WALLET_BUNDLER_FEE_USDC=100000
# WALLET_BUNDLER_BENEFICIARY=
WALLET_BUNDLER_FEE_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
WALLET_FEE_TOKEN_SYMBOL=USDC

# UI (Vite) — Reown AppKit project ID for WalletConnect in Super Wallet EOA enrollment.
# MetaMask/injected wallets work without this; set for WalletConnect QR in production UI builds.
# VITE_REOWN_PROJECT_ID=
