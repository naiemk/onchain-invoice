# Testnet bootstrap — copy to .env and fill in your funded operator wallet + RPC URLs.
# One key works everywhere: set EVM_PRIVATE_KEY only; node keys are copied automatically.

API_SIGNING_SECRET=

# Operator wallet (needs Sepolia ETH, BSC testnet BNB, Nile TRX for gas + seeding)
EVM_PRIVATE_KEY=
TRON_PRIVATE_KEY=

# RPC / hosts
SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=
NILE_FULL_HOST=https://nile.trongrid.io

# DEX routers for LiquidityManager (OpenOcean whitelisted targets; testnet liquidity may be thin)
SEPOLIA_ROUTER_ADDRESS=
BSC_TESTNET_ROUTER_ADDRESS=
TRON_ROUTER_ADDRESS=

# Optional — derived from EVM_PRIVATE_KEY if omitted
FASTSWAP_OWNER_ADDRESS=

# Explorer verify (optional)
ETHERSCAN_API_KEY=
