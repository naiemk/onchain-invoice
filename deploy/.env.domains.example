# Shared settings for docker-compose.domains.yml
# cp deploy/.env.domains.example deploy/.env.domains

IMAGE_TAG=main

# Let's Encrypt live cert (one SAN cert covering apex + www + testnet)
TLS_FULLCHAIN=/etc/letsencrypt/live/trustless-commerce.com/fullchain.pem
TLS_PRIVKEY=/etc/letsencrypt/live/trustless-commerce.com/privkey.pem
CERTBOT_WWW=/var/www/certbot

# Host bind mounts for SQLite (chown 1000:1000)
TESTNET_DATA_DIR=/var/lib/trustless-commerce/testnet/api
MAINNET_DATA_DIR=/var/lib/trustless-commerce/mainnet/api

TESTNET_CORS_ORIGINS=https://testnet.trustless-commerce.com
MAINNET_CORS_ORIGINS=https://trustless-commerce.com,https://www.trustless-commerce.com
TESTNET_RATE_LIMIT_CREATE_PER_SECOND=5
MAINNET_RATE_LIMIT_CREATE_PER_SECOND=1
