# syntax=docker/dockerfile:1
# Build from repo root: docker build -f deploy/Dockerfile.api -t trustless-commerce-api .
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY . .
RUN npm ci && npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY --from=build /app /app
RUN mkdir -p /config /data \
  && cp /app/commerce/config/server.example.yaml /config/server.yaml \
  && chown -R node:node /app /config /data
USER node
ENV NODE_ENV=production
ENV CONFIG_PATH=/config/server.yaml
ENV DB_PATH=/data/trustless-commerce.db
EXPOSE 8080
CMD ["node", "commerce-dist/server/index.js"]
