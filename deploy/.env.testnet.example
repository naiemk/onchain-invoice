# Env for testnet-api (Sepolia). cp to deploy/.env.testnet
# Used by docker-compose.domains.yml via env_file.

BASE_URL=https://testnet.trustless-commerce.com
ADMIN_API_KEY=change-me-testnet-admin
SWEEPER_API_KEY=change-me-testnet-sweeper

# Sepolia — data/commerce-deploy-sepolia.json
EVM_RPC_URL=https://sepolia.drpc.org
SWEEPER_ADDRESS=0x5bcbEF31E3DcE37235CF8B2900ca7a1439e46cB9
FORWARDER_IMPLEMENTATION=0x0bA4bb324eB41d9c0f1c4Ac7a3876dEfcc4d72b9

# Optional card/bank sandbox. Testnet: ONRAMPER_ENABLED=1 alone turns on demo UX (no Onramper keys).
# Set ONRAMPER_ENABLED=0 to disable. Demo does not fund Sepolia/Nile.
ONRAMPER_ENABLED=1
# Live Onramper sandbox: set ONRAMPER_API_KEY=pk_test_... and ONRAMPER_SIGNING_KEY (HMAC hex from the dashboard).
