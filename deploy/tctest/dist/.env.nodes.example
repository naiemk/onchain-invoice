# Trustless Commerce nodes — tctest (testnet). Copy to .env on the VPS; do not commit secrets.
# Compose: sweeper-evm | sweeper-tron | bundler-evm | wallet-deployer-evm (+ solana profile)

DOCKER_NETWORK=vps-edge
APP_PREFIX=tctest
COMPOSE_PROJECT_NAME=tctest-nodes
WORKER_IMAGE=ghcr.io/naiemk/trustless-commerce-sweeper:main
SWEEPER_IMAGE=ghcr.io/naiemk/trustless-commerce-sweeper:main
COMPOSE_FILE=docker-compose.workers.yml
CONFIG_FILE=nodes-workers.yaml
PERSIST_LOG_DIR=./persist-logs
NODES_AUTO_UPDATE=1
NODES_AUTO_UPDATE_INTERVAL_MIN=30
NODES_STOP_TIMEOUT=180
DOCKER_AUTO_PRUNE=1
DOCKER_PRUNE_UNUSED=0
DOCKER_PRUNE_UNTIL=72h

# Prefer public HTTPS gateway; docker DNS alternative: http://tctest-api:8080
API_URL=https://testnet.trustless-commerce.com
SERVER_URL=https://testnet.trustless-commerce.com

ADMIN_API_KEY=change-me-admin
SWEEPER_API_KEY=change-me-sweeper

# Wallet that signs sweeper API requests (register this address on the API)
# Default below is Hardhat #0 — testnet/throwaway only.
SWEEPER_WALLET_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SWEEPER_REGISTER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
SWEEPER_LABEL=node-1
SWEEPER_CHAINS=11155111,nile
# With Solana: SWEEPER_CHAINS=11155111,nile,devnet  and SWEEPER_SOLANA_ENABLED=1

# --- Ethereum Sepolia ---
EVM_RPC_URL=https://sepolia.drpc.org
SWEEPER_ADDRESS=0x5bcbEF31E3DcE37235CF8B2900ca7a1439e46cB9
SWEEPER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Mainnet EVM (leave empty on testnet; soft-skipped until filled) ---
EVM_8453_RPC_URL=https://mainnet.base.org
EVM_8453_SWEEPER_ADDRESS=
EVM_56_RPC_URL=https://bsc-dataseed.binance.org
EVM_56_SWEEPER_ADDRESS=

# --- Tron Nile ---
TRON_CHAIN_ID=nile
TRON_FULL_HOST=https://nile.trongrid.io
TRON_INVOICE_MASTER_SECRET=change-me-tron-invoice-master-secret
TRON_USDT_ADDRESS=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
TRON_SPONSOR_PRIVATE_KEY=

# --- Solana Devnet (compose profile "solana") ---
SWEEPER_SOLANA_ENABLED=0
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_USDT_MINT=PLACEHOLDER_DEVNET_USDT_MINT
SOLANA_SWEEPER_KEY=
SOLANA_FEE_RECIPIENT=
SOLANA_MAINNET_ENABLED=0
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_PROGRAM_ID=PLACEHOLDER_MAINNET_PROGRAM_ID

ACTIVITY_LOG_PATH=/data/logs/activity.jsonl
SWEEPER_MEMORY_LIMIT=192m

# --- Wallet bundler + deployer ---
BUNDLER_MEMORY_LIMIT=192m
WALLET_DEPLOYER_MEMORY_LIMIT=192m
BUNDLER_WALLET_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BUNDLER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
BUNDLER_REGISTER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
BUNDLER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
WALLET_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
WALLET_CHAIN_ID=11155111
WALLET_FACTORY_ADDRESS=0x2b245a20589c745B11F8a69C677F891e8175a550
WALLET_ENTRYPOINT_ADDRESS=0x433709009B8330FDa32311DF1C2AFA402eD8D009
WALLET_BUNDLER_FEE_USDC=100000
WALLET_BUNDLER_BENEFICIARY=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
WALLET_BUNDLER_FEE_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
