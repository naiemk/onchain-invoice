# syntax=docker/dockerfile:1
# Build from repo root: docker build -f deploy/Dockerfile.wallet-deployer -t trustless-commerce-wallet-deployer .
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY . .
RUN npm ci && npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /data/logs && chown -R node:node /data
COPY --from=build /app /app
USER node
ENV NODE_ENV=production
ENV ACTIVITY_LOG_PATH=/data/logs/wallet-deployer-activity.jsonl
CMD ["node", "commerce-dist/wallet-deployer/index.js"]
