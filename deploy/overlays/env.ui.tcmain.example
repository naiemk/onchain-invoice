# Trustless Commerce UI — tcmain (mainnet). Copy to .env on the VPS.

DOCKER_NETWORK=vps-edge
UI_NAME=tcmain-ui
UI_IMAGE=ghcr.io/naiemk/trustless-commerce-ui:main
UI_MEMORY_LIMIT=64m
PERSIST_LOG_DIR=./persist-logs
UI_AUTO_UPDATE=1
UI_AUTO_UPDATE_INTERVAL_MIN=20
UI_STOP_TIMEOUT=30
DOCKER_AUTO_PRUNE=1
DOCKER_PRUNE_UNUSED=0
DOCKER_PRUNE_UNTIL=72h

# Optional — Reown AppKit (WalletConnect) for Super Wallet EOA keys in UI build args.
# VITE_REOWN_PROJECT_ID=
