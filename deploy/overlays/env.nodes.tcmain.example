# Trustless Commerce nodes — tcmain (mainnet). Copy to .env on the VPS; do not commit secrets.
# Chains: Base 8453, BNB 56, Tron mainnet (no Solana). Replace every _PRIVATE_KEY_ before go-live.

DOCKER_NETWORK=vps-edge
APP_PREFIX=tcmain
COMPOSE_PROJECT_NAME=tcmain-nodes
WORKER_IMAGE=ghcr.io/naiemk/trustless-commerce-sweeper:main
SWEEPER_IMAGE=ghcr.io/naiemk/trustless-commerce-sweeper:main
COMPOSE_FILE=docker-compose.workers.yml
CONFIG_FILE=nodes-workers.yaml
PERSIST_LOG_DIR=./persist-logs
NODES_AUTO_UPDATE=1
NODES_AUTO_UPDATE_INTERVAL_MIN=30
NODES_STOP_TIMEOUT=180
DOCKER_AUTO_PRUNE=1
DOCKER_PRUNE_UNUSED=0
DOCKER_PRUNE_UNTIL=72h

# Prefer public HTTPS; docker DNS alternative: http://tcmain-api:8080
API_URL=https://trustless-commerce.com
SERVER_URL=https://trustless-commerce.com

ADMIN_API_KEY=change-me-mainnet-admin
SWEEPER_API_KEY=change-me-mainnet-sweeper

SWEEPER_WALLET_KEY=_PRIVATE_KEY_
SWEEPER_PRIVATE_KEY=_PRIVATE_KEY_
SWEEPER_REGISTER_ADDRESS=
SWEEPER_LABEL=mainnet-node-1
SWEEPER_CHAINS=8453,56,tron

# Sepolia unused on mainnet
EVM_RPC_URL=
SWEEPER_ADDRESS=

# Base + BNB
EVM_8453_RPC_URL=https://mainnet.base.org
EVM_8453_SWEEPER_ADDRESS=0x32D81953F60094A484eaFFB4583933b074921f4A
EVM_56_RPC_URL=https://bsc-dataseed.binance.org
EVM_56_SWEEPER_ADDRESS=0xa9C13F34DDF8eFe64e628f38EebE80c2E9D8B59d

# Tron mainnet
TRON_CHAIN_ID=tron
TRON_FULL_HOST=https://api.trongrid.io
TRON_INVOICE_MASTER_SECRET=_PRIVATE_KEY_
TRON_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_SPONSOR_PRIVATE_KEY=_PRIVATE_KEY_

# Solana off
SWEEPER_SOLANA_ENABLED=0
SOLANA_RPC_URL=
SOLANA_PROGRAM_ID=
SOLANA_SWEEPER_KEY=
SOLANA_MAINNET_ENABLED=0

ACTIVITY_LOG_PATH=/data/logs/activity.jsonl
SWEEPER_MEMORY_LIMIT=192m

# Wallet bundler + deployer (parity with tctest; fill keys when wallet ops go live on mainnet)
BUNDLER_MEMORY_LIMIT=192m
WALLET_DEPLOYER_MEMORY_LIMIT=192m
BUNDLER_WALLET_KEY=_PRIVATE_KEY_
BUNDLER_ADDRESS=
BUNDLER_REGISTER_ADDRESS=
BUNDLER_PRIVATE_KEY=_PRIVATE_KEY_
WALLET_DEPLOYER_PRIVATE_KEY=_PRIVATE_KEY_
WALLET_CHAIN_ID=8453
WALLET_FACTORY_ADDRESS=
WALLET_ENTRYPOINT_ADDRESS=
WALLET_BUNDLER_FEE_USDC=100000
WALLET_BUNDLER_BENEFICIARY=
WALLET_BUNDLER_FEE_TOKEN=
