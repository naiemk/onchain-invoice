# Trustless Commerce API — tctest (testnet). Copy to .env on the VPS; do not commit secrets.
# vibed-infra 0.8 keys + TC product secrets. Host gateway reaches this container on DOCKER_NETWORK.

DOCKER_NETWORK=vps-edge
DOCKER_NAME=tctest-api
BACKEND_IMAGE=ghcr.io/naiemk/trustless-commerce-api:main
# 0 = no host publish (gateway-only on vps-edge)
HOST_PORT=0
DATA_DIR=./data
CONFIG_FILE=api-app.yaml
API_MEMORY_LIMIT=384m
PERSIST_LOG_DIR=./persist-logs
API_AUTO_UPDATE=1
API_AUTO_UPDATE_INTERVAL_MIN=30
API_STOP_TIMEOUT=120
DOCKER_AUTO_PRUNE=1
DOCKER_PRUNE_UNUSED=0
DOCKER_PRUNE_UNTIL=72h

ADMIN_API_KEY=change-me-admin
SWEEPER_API_KEY=change-me-sweeper

# Public HTTPS URL behind the gateway
BASE_URL=https://testnet.trustless-commerce.com

# --- Testnet: Ethereum Sepolia ---
EVM_RPC_URL=https://sepolia.drpc.org
SWEEPER_ADDRESS=0x5bcbEF31E3DcE37235CF8B2900ca7a1439e46cB9
FORWARDER_IMPLEMENTATION=0x0bA4bb324eB41d9c0f1c4Ac7a3876dEfcc4d72b9

# --- Mainnet EVM (fill after CREATE2; soft-skipped until set) ---
EVM_8453_RPC_URL=https://mainnet.base.org
EVM_8453_SWEEPER_ADDRESS=
EVM_8453_FORWARDER_IMPLEMENTATION=
EVM_56_RPC_URL=https://bsc-dataseed.binance.org
EVM_56_SWEEPER_ADDRESS=
EVM_56_FORWARDER_IMPLEMENTATION=

# Tron Nile
TRON_FULL_HOST=https://nile.trongrid.io
TRON_INVOICE_MASTER_SECRET=change-me-tron-invoice-master-secret
TRON_USDT_ADDRESS=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf

# Solana Devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_USDT_MINT=PLACEHOLDER_DEVNET_USDT_MINT
SOLANA_MAINNET_ENABLED=0
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_PROGRAM_ID=PLACEHOLDER_MAINNET_PROGRAM_ID

# --- Passkey smart wallet (Sepolia) ---
WALLET_FACTORY_ADDRESS=0x06964dE197ed29A4DC2D34F68aD4510Afa25f537
WALLET_RECOVERY_ADDRESS=0x72739889bcce2B08a23212bae6C7B9F1C29e7873
WALLET_IMPLEMENTATION_ADDRESS=0xe024cE8ed1878dBdd3ca8E73B1e586c4E46dC85C
WALLET_RECOVERY_TIMELOCK=259200
WALLET_CHAIN_ID=11155111
WALLET_ENTRYPOINT_ADDRESS=0x433709009B8330FDa32311DF1C2AFA402eD8D009
WALLET_BUNDLER_FEE_USDC=100000
WALLET_BUNDLER_FEE_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
