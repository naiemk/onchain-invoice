# Env for mainnet-api. cp to deploy/.env.mainnet
# Used by docker-compose.domains.yml via env_file.
# Fill Base + BNB sweeper/forwarder after CREATE2 (npm run deploy:console).
# Mainnet product chains: Base (8453 USDC), BNB (56 USDC+USDT), Tron (USDT).

BASE_URL=https://trustless-commerce.com
ADMIN_API_KEY=change-me-mainnet-admin
SWEEPER_API_KEY=change-me-mainnet-sweeper

# Legacy Sepolia flat fields — leave empty on mainnet (do not paste testnet addresses)
EVM_RPC_URL=
SWEEPER_ADDRESS=
FORWARDER_IMPLEMENTATION=

# Base (8453) — USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
EVM_8453_RPC_URL=https://mainnet.base.org
EVM_8453_SWEEPER_ADDRESS=
EVM_8453_FORWARDER_IMPLEMENTATION=

# BNB Smart Chain (56) — USDC 0x8AC76a51… / USDT 0x55d39832…
EVM_56_RPC_URL=https://bsc-dataseed.binance.org
EVM_56_SWEEPER_ADDRESS=
EVM_56_FORWARDER_IMPLEMENTATION=

# Tron mainnet
TRON_FULL_HOST=https://api.trongrid.io
TRON_INVOICE_MASTER_SECRET=change-me-tron-invoice-master-secret
TRON_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
