# Env for mainnet-api. Used by /root/tc/api-mainnet on the VPS.
# Private key / master-secret slots use _PRIVATE_KEY_ — replace before go-live.
# Mainnet product chains: Base (8453), BNB (56), Tron (USDT). No Solana.

ADMIN_API_KEY=change-me-mainnet-admin
SWEEPER_API_KEY=change-me-mainnet-sweeper

BASE_URL=https://trustless-commerce.com
DOCKER_NETWORK=trustless-commerce-edge
DOCKER_NAME=mainnet-api

# Legacy Sepolia flat fields — leave empty on mainnet
EVM_RPC_URL=
SWEEPER_ADDRESS=
FORWARDER_IMPLEMENTATION=

# Base (8453) — CREATE2 from deploy/operator/config.yaml
EVM_8453_RPC_URL=https://mainnet.base.org
EVM_8453_SWEEPER_ADDRESS=0x32D81953F60094A484eaFFB4583933b074921f4A
EVM_8453_FORWARDER_IMPLEMENTATION=0x910f662AEf6396625D3E8766c6a775beAA764f2b

# BNB Smart Chain (56)
EVM_56_RPC_URL=https://bsc-dataseed.binance.org
EVM_56_SWEEPER_ADDRESS=0xa9C13F34DDF8eFe64e628f38EebE80c2E9D8B59d
EVM_56_FORWARDER_IMPLEMENTATION=0x45D2D21083aD6408569e4D03796737EaE3dcF539

# Tron mainnet — set TRON_INVOICE_MASTER_SECRET before creating invoices
TRON_FULL_HOST=https://api.trongrid.io
TRON_INVOICE_MASTER_SECRET=_PRIVATE_KEY_
TRON_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Solana off for mainnet product rails
SOLANA_RPC_URL=
SOLANA_PROGRAM_ID=
SOLANA_MAINNET_ENABLED=0

CORS_ORIGINS=https://trustless-commerce.com,https://www.trustless-commerce.com

# Optional card/bank onramp (Onramper). Enabled automatically when keys are set; set ONRAMPER_ENABLED=0 to disable.
# Keep disabled on testnet — card rails do not fund Sepolia/Nile.
# ONRAMPER_ENABLED=0
# ONRAMPER_API_KEY=
# ONRAMPER_SIGNING_KEY=
# ONRAMPER_WIDGET_ORIGIN=https://buy.onramper.com
# ONRAMPER_FIATS=USD,EUR,GBP,SEK

# Disable testnet faucet on mainnet.
FAUCET_ENABLED=0

# Auto-update ON for mainnet API (staggered 30m @ :00 + host flock)
API_AUTO_UPDATE=1
API_AUTO_UPDATE_INTERVAL_MIN=30
API_STOP_TIMEOUT=120
API_MEMORY_LIMIT=384m
