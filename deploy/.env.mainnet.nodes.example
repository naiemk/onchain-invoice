# Env for mainnet sweepers (/root/tc/sweeper-mainnet).
# Replace every _PRIVATE_KEY_ then: ./start-onchain-invoice-nodes.sh && ./register-onchain-invoice-node.sh
# Chains: Base 8453, BNB 56, Tron mainnet (no Solana).

API_URL=https://trustless-commerce.com
SERVER_URL=https://trustless-commerce.com

ADMIN_API_KEY=change-me-mainnet-admin
SWEEPER_API_KEY=change-me-mainnet-sweeper

# Signing wallet for sweeper API auth + on-chain EVM sweeps (same key OK).
# After setting a real key, set SWEEPER_REGISTER_ADDRESS to its 0x address.
SWEEPER_WALLET_KEY=_PRIVATE_KEY_
SWEEPER_PRIVATE_KEY=_PRIVATE_KEY_
SWEEPER_REGISTER_ADDRESS=
SWEEPER_LABEL=mainnet-node-1
SWEEPER_CHAINS=8453,56,tron

# Sepolia unused on mainnet
EVM_RPC_URL=
SWEEPER_ADDRESS=

# Base + BNB
EVM_8453_RPC_URL=https://mainnet.base.org
EVM_8453_SWEEPER_ADDRESS=0x32D81953F60094A484eaFFB4583933b074921f4A
EVM_56_RPC_URL=https://bsc-dataseed.binance.org
EVM_56_SWEEPER_ADDRESS=0xa9C13F34DDF8eFe64e628f38EebE80c2E9D8B59d

# Tron mainnet
TRON_CHAIN_ID=tron
TRON_FULL_HOST=https://api.trongrid.io
TRON_INVOICE_MASTER_SECRET=_PRIVATE_KEY_
TRON_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_SPONSOR_PRIVATE_KEY=_PRIVATE_KEY_

# Solana off
SWEEPER_SOLANA_ENABLED=0
SOLANA_RPC_URL=
SOLANA_PROGRAM_ID=
SOLANA_SWEEPER_KEY=
SOLANA_MAINNET_ENABLED=0

ACTIVITY_LOG_PATH=/data/logs/activity.jsonl
SWEEPER_MEMORY_LIMIT=192m

# Pull GHCR :main and recreate mainnet-sweeper-* when the digest changes.
# Staggered 30m @ :10 + host flock with api/gateway.
NODES_AUTO_UPDATE=1
NODES_AUTO_UPDATE_INTERVAL_MIN=30
NODES_STOP_TIMEOUT=180

# Prefer GHCR so auto-update can replace containers (do not pin a local-only tag).
SWEEPER_IMAGE=ghcr.io/naiemk/trustless-commerce-sweeper:main

# start-onchain-invoice-nodes.sh uses this compose file for mainnet install dirs
COMPOSE_FILE=docker-compose.sweepers-mainnet.yml
