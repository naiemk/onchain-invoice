# Gateway (HTTPS nginx + UI). Copied to .env by install-gateway.sh if missing.
# Requires Let's Encrypt certs on the host (see deploy/install/README.md).

IMAGE_TAG=main
DOCKER_NETWORK=trustless-commerce-edge

# Container names (must match API installs + nginx upstreams)
TESTNET_UI_NAME=testnet-ui
MAINNET_UI_NAME=mainnet-ui
GATEWAY_NAME=onchain-invoice-gateway

UI_IMAGE=ghcr.io/naiemk/trustless-commerce-ui
NGINX_IMAGE=ghcr.io/naiemk/trustless-commerce-nginx

# Let's Encrypt (SAN cert covering apex + www + testnet)
TLS_FULLCHAIN=/etc/letsencrypt/live/trustless-commerce.com/fullchain.pem
TLS_PRIVKEY=/etc/letsencrypt/live/trustless-commerce.com/privkey.pem
CERTBOT_WWW=/var/www/certbot

# Host ports
HTTP_PORT=80
HTTPS_PORT=443

# --- Auto-update (per container) ---
# Cron runs update-onchain-invoice-gateway.sh; each flag controls one container.
# install-gateway.sh refreshes cron via ./install-auto-update.sh
# Default interval 20m at :20; host flock + digest-gated pull before any stop.
UI_TESTNET_AUTO_UPDATE=1
UI_MAINNET_AUTO_UPDATE=1
# nginx edge (onchain-invoice-gateway)
GATEWAY_AUTO_UPDATE=1
# How often cron runs the gateway updater (minutes)
GATEWAY_AUTO_UPDATE_INTERVAL_MIN=20
# docker stop grace before recreate (seconds)
GATEWAY_STOP_TIMEOUT=60
# Docker --memory caps (shared 1 GB host defaults)
UI_MEMORY_LIMIT=64m
GATEWAY_MEMORY_LIMIT=64m
