# Copy to .env (install-api.sh does this if .env is missing). Do not commit secrets.
# Sourced by ./start-onchain-invoice-api.sh

ADMIN_API_KEY=change-me-admin
SWEEPER_API_KEY=change-me-sweeper

# Public HTTPS URL behind the gateway (not http://localhost:8080).
# Testnet: https://testnet.trustless-commerce.com
# Mainnet: https://trustless-commerce.com
BASE_URL=https://testnet.trustless-commerce.com

# Join the gateway Docker network and use a stable DNS name for nginx upstreams.
DOCKER_NETWORK=trustless-commerce-edge
# testnet → testnet-api ; mainnet → mainnet-api
DOCKER_NAME=testnet-api

# --- Testnet: Ethereum Sepolia (see data/commerce-deploy-sepolia.json) ---
EVM_RPC_URL=https://sepolia.drpc.org
SWEEPER_ADDRESS=0x5bcbEF31E3DcE37235CF8B2900ca7a1439e46cB9
FORWARDER_IMPLEMENTATION=0x0bA4bb324eB41d9c0f1c4Ac7a3876dEfcc4d72b9

# --- Mainnet EVM (fill after npm run deploy:console CREATE2 on Base + BNB) ---
# Create returns 503 for a chain until sweeper + forwarder are set.
EVM_8453_RPC_URL=https://mainnet.base.org
EVM_8453_SWEEPER_ADDRESS=
EVM_8453_FORWARDER_IMPLEMENTATION=
EVM_56_RPC_URL=https://bsc-dataseed.binance.org
EVM_56_SWEEPER_ADDRESS=
EVM_56_FORWARDER_IMPLEMENTATION=

# Tron Nile (EOA invoice address prediction on create)
# Mainnet: TRON_FULL_HOST=https://api.trongrid.io  TRON_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_FULL_HOST=https://nile.trongrid.io
TRON_INVOICE_MASTER_SECRET=change-me-tron-invoice-master-secret
# Nile USDT TRC-20 (document only for API; sweeper YAML uses the same env)
TRON_USDT_ADDRESS=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf

# Solana Devnet (ATA prediction on create). Same programId as the solana sweeper.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_USDT_MINT=PLACEHOLDER_DEVNET_USDT_MINT
SOLANA_MAINNET_ENABLED=0
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_PROGRAM_ID=PLACEHOLDER_MAINNET_PROGRAM_ID

# Optional
# CORS_ORIGINS=https://testnet.trustless-commerce.com

# --- Auto-update (API container) ---
# Cron pulls GHCR and recreates this API when the digest changes.
# Default OFF for stability; set API_AUTO_UPDATE=1 then ./install-auto-update.sh
# Interval default 30m; host flock + digest skip avoid overlapping pulls on small VPS.
API_AUTO_UPDATE=0
API_AUTO_UPDATE_INTERVAL_MIN=30
API_STOP_TIMEOUT=120
# Docker --memory (shared 1 GB host default)
API_MEMORY_LIMIT=384m
