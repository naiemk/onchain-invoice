# Copy to .env (install-nodes.sh does this if .env is missing). Do not commit secrets.
# Sourced by ./start-onchain-invoice-nodes.sh and ./register-onchain-invoice-node.sh

# API base (no trailing slash). Prefer the public HTTPS gateway.
# Testnet: https://testnet.trustless-commerce.com
# Mainnet: https://trustless-commerce.com
API_URL=https://testnet.trustless-commerce.com
SERVER_URL=https://testnet.trustless-commerce.com

# Must match the API admin key (for register-onchain-invoice-node.sh)
ADMIN_API_KEY=change-me-admin
# Legacy shared key — must match API SWEEPER_API_KEY if used
SWEEPER_API_KEY=change-me-sweeper

# Wallet that signs sweeper API requests (register this address on the API)
# Default below is Hardhat #0 — testnet/throwaway only.
SWEEPER_WALLET_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SWEEPER_REGISTER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
SWEEPER_LABEL=node-1
SWEEPER_CHAINS=11155111

# Chain / contract (Sepolia)
EVM_RPC_URL=https://sepolia.drpc.org
SWEEPER_ADDRESS=0x5bcbEF31E3DcE37235CF8B2900ca7a1439e46cB9
# Optional: same as wallet key if this node also submits on-chain sweeps
SWEEPER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Persistent activity log inside the container (host path: ./logs/activity.jsonl)
ACTIVITY_LOG_PATH=/data/logs/activity.jsonl

# --- Auto-update (sweeper node) ---
# Cron pulls the GHCR sweeper image and recreates the container when the digest changes.
# Testnet default ON. For mainnet / production use NODES_AUTO_UPDATE=0.
NODES_AUTO_UPDATE=1
NODES_AUTO_UPDATE_INTERVAL_MIN=15
# Grace period so an in-flight sweep can finish (seconds)
NODES_STOP_TIMEOUT=180
