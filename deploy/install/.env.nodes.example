# Copy to .env (install-nodes.sh does this if .env is missing). Do not commit secrets.
# Sourced by ./start-onchain-invoice-nodes.sh and ./register-onchain-invoice-node.sh
# Triple sweepers: docker compose -f docker-compose.sweepers.yml up -d
#   onchain-invoice-sweeper-evm | -tron | -solana

# API base (no trailing slash). Prefer the public HTTPS gateway.
# Testnet: https://testnet.trustless-commerce.com
# Mainnet: https://trustless-commerce.com
API_URL=https://testnet.trustless-commerce.com
SERVER_URL=https://testnet.trustless-commerce.com

# Must match the API admin key (for register-onchain-invoice-node.sh)
ADMIN_API_KEY=change-me-admin
# Legacy shared key — must match API SWEEPER_API_KEY if used
SWEEPER_API_KEY=change-me-sweeper

# Wallet that signs sweeper API requests (register this address on the API)
# Default below is Hardhat #0 — testnet/throwaway only.
SWEEPER_WALLET_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SWEEPER_REGISTER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
SWEEPER_LABEL=node-1
# Include chains this node should claim (omit devnet unless Solana is enabled)
# Testnet default:
SWEEPER_CHAINS=11155111,nile
# With Solana: SWEEPER_CHAINS=11155111,nile,devnet  and SWEEPER_SOLANA_ENABLED=1
# Mainnet (after CREATE2 + Tron master secret): SWEEPER_CHAINS=8453,56,tron

# --- Ethereum Sepolia (SWEEPER_ROLE=evm) ---
EVM_RPC_URL=https://sepolia.drpc.org
SWEEPER_ADDRESS=0x5bcbEF31E3DcE37235CF8B2900ca7a1439e46cB9
# Optional: same as wallet key if this node also submits on-chain sweeps
SWEEPER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Mainnet EVM (leave empty on testnet; soft-skipped until filled) ---
EVM_8453_RPC_URL=https://mainnet.base.org
EVM_8453_SWEEPER_ADDRESS=
EVM_56_RPC_URL=https://bsc-dataseed.binance.org
EVM_56_SWEEPER_ADDRESS=

# --- Tron (SWEEPER_ROLE=tron) ---
# Testnet Nile:
TRON_CHAIN_ID=nile
TRON_FULL_HOST=https://nile.trongrid.io
TRON_INVOICE_MASTER_SECRET=change-me-tron-invoice-master-secret
TRON_USDT_ADDRESS=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
# Mainnet:
# TRON_CHAIN_ID=tron
# TRON_FULL_HOST=https://api.trongrid.io
# TRON_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Sponsor key for ENERGY/BANDWIDTH delegation + reclaim (hex). Must have staked TRX.
# Do not put this key on the API — only on the sweeper node.
TRON_SPONSOR_PRIVATE_KEY=

# --- Solana Devnet (SWEEPER_ROLE=solana) ---
# Off by default on small VPS (compose profile "solana"). Set SWEEPER_SOLANA_ENABLED=1 to start.
SWEEPER_SOLANA_ENABLED=0
# Public RPC; override with a dedicated provider if rate-limited.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Set after: npm run solana:deploy:devnet (program id from solana/data/commerce-deploy-devnet.json)
# Until set, the solana compose service stays up but skips settle (see activity log: solana-disabled).
SOLANA_PROGRAM_ID=
# Circle Devnet USDC
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Leave PLACEHOLDER until you have a Devnet USDT mint (UI offers USDC only meanwhile)
SOLANA_USDT_MINT=PLACEHOLDER_DEVNET_USDT_MINT
# Authority that ran initialize. Prefer base58 secret (single line). JSON byte arrays also work
# if single-line; keep YAML quoting around ${SOLANA_SWEEPER_KEY} (installer template does).
SOLANA_SWEEPER_KEY=
# Fee destination pubkey (base58). Leave empty to default to the authority pubkey.
SOLANA_FEE_RECIPIENT=
# Mainnet placeholders — keep disabled until program is deployed
SOLANA_MAINNET_ENABLED=0
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_PROGRAM_ID=PLACEHOLDER_MAINNET_PROGRAM_ID

# Persistent activity log inside the container (host path: ./logs/)
# Single-container start uses ACTIVITY_LOG_PATH; compose overrides per service.
ACTIVITY_LOG_PATH=/data/logs/activity.jsonl

# Per-sweeper Docker memory (compose mem_limit / single-container --memory)
SWEEPER_MEMORY_LIMIT=192m

# --- Auto-update (sweeper node) ---
# Cron pulls the GHCR sweeper image and recreates containers when the digest changes.
# Testnet default ON. For mainnet / production use NODES_AUTO_UPDATE=0.
# Default interval 30m; staggered (:10) + host flock with api/gateway.
NODES_AUTO_UPDATE=1
NODES_AUTO_UPDATE_INTERVAL_MIN=30
# Grace period so an in-flight sweep can finish (seconds)
NODES_STOP_TIMEOUT=180
