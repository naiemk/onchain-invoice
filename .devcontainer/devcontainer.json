// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	"build": {
		"dockerfile": "./Dockerfile"
	},
	// Default workspace is onchain-invoice; explicitly bind the sibling fastswap repo.
	// Host layout: ~/nk/onchain-invoice and ~/nk/fastswap
	"workspaceFolder": "/workspaces/onchain-invoice",
	"mounts": [
		"source=${localWorkspaceFolder}/../fastswap,target=/workspaces/fastswap,type=bind"
	],
	"features": {
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-containers",
				"ms-azuretools.vscode-docker",
				"esbenp.prettier-vscode",
				"NomicFoundation.hardhat-solidity"
			]
		}
	},
	"remoteUser": "node"
}
